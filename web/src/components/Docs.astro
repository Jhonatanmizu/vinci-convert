---
const REPO_URL = "https://github.com/jhonatanmizu/vinci-convert";
const RELEASES_URL = `${REPO_URL}/releases`;

const installCards = [
  {
    title: "Linux",
    pkg: "AppImage",
    note: "Portable — chmod +x and run",
    url: RELEASES_URL,
    cta: "Grab the AppImage",
  },
  {
    title: "Windows",
    pkg: "setup.exe",
    note: "Per-user installer, no admin needed",
    url: RELEASES_URL,
    cta: "Get the installer",
  },
  {
    title: "Source",
    pkg: "uv sync",
    note: "Python ≥ 3.11 + ffmpeg on PATH",
    url: REPO_URL,
    cta: "Clone the repo",
  },
];

const commands = [
  { c: "vinci-convert convert video.mp4", d: "" },
  { c: "vinci-convert convert ./clips/", d: "# recursive batch" },
  { c: "vinci-convert export clip.mov", d: "" },
  { c: "vinci-convert export-all", d: "# all converted files" },
  { c: "vinci-convert clean", d: "# tidy up output" },
];

const logic = [
  { cond: "Standard footage", out: "prores_ks · profile 3 (HQ)", pix: "yuv422p10le" },
  { cond: "Alpha (yuva / rgba)", out: "prores_ks · profile 4444", pix: "yuva444p10le" },
  { cond: "Alpha 12-bit .mov", out: "stream copy (no re-encode)", pix: "—" },
];
---

<section class="section docs" id="docs">
  <div class="container">
    <div class="section-head section-head--center">
      <div class="eyebrow">// docs</div>
      <h2 class="section-title">Três passos. Nenhum mistério.</h2>
      <p class="section-sub">
        ffmpeg is the only runtime dependency. Install, point it at a
        folder, cut.
      </p>
    </div>

    <div class="install-grid">
      {installCards.map((c) => (
        <a class="install-card" href={c.url}>
          <div class="install-top">
            <span class="c-title">{c.title}</span>
            <span class="c-pkg">{c.pkg}</span>
          </div>
          <p>{c.note}</p>
          <span class="c-cta">{c.cta} →</span>
        </a>
      ))}
    </div>

    <div class="doc-grid">
      <div>
        <h3 class="doc-h">CLI at a glance</h3>
        <pre class="code-block"><code>{commands
          .map((l) => `${l.c}${l.d ? "  " + l.d : ""}`)
          .join("\n")}</code></pre>
      </div>

      <div>
        <h3 class="doc-h">Conversion logic</h3>
        <table class="logic">
          {logic.map((r) => (
            <tr>
              <td class="cond">{r.cond}</td>
              <td class="out">{r.out}</td>
              <td class="pix">{r.pix}</td>
            </tr>
          ))}
        </table>
      </div>
    </div>
  </div>
</section>

<style>
  .docs {
    background: var(--mantle);
  }

  .install-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-bottom: 44px;
  }

  .install-card {
    display: block;
    background: var(--crust);
    border: 1px solid var(--surface0);
    border-radius: var(--radius);
    padding: 24px;
    color: var(--text);
  }

  .install-card:hover {
    border-color: var(--surface1);
    text-decoration: none;
  }

  .install-top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 12px;
  }

  .c-title {
    font-size: 18px;
    font-weight: 700;
    color: var(--lavender);
  }

  .c-pkg {
    font-size: 12px;
    color: var(--overlay0);
    background: var(--mantle);
    border: 1px solid var(--surface1);
    border-radius: 900px;
    padding: 4px 10px;
  }

  .install-card p {
    font-size: 13.5px;
    color: var(--subtext0);
  }

  .c-cta {
    display: inline-block;
    margin-top: 14px;
    font-size: 13.5px;
    font-weight: 600;
    color: var(--teal);
  }

  .doc-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }

  .doc-h {
    font-size: 14px;
    color: var(--overlay0);
    margin-bottom: 12px;
    font-weight: 600;
  }

  .logic {
    width: 100%;
    border-collapse: collapse;
    background: var(--crust);
    border: 1px solid var(--surface0);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .logic tr {
    border-bottom: 1px solid var(--surface0);
  }
  .logic tr:last-child {
    border-bottom: none;
  }

  .logic td {
    font-size: 13px;
    padding: 14px 16px;
  }

  .cond {
    color: var(--subtext0);
  }
  .out {
    color: var(--text);
  }
  .pix {
    color: var(--mauve);
    text-align: right;
  }

  @media (max-width: 880px) {
    .install-grid,
    .doc-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 480px) {
    .logic {
      display: block;
    }
    .logic tbody {
      display: block;
    }
    .logic tr {
      display: flex;
      flex-direction: column;
      gap: 4px;
      padding: 14px 16px;
    }
    .logic td {
      padding: 0;
    }
    .pix {
      text-align: left;
    }
    .code-block {
      font-size: 12.5px;
      padding: 16px;
    }
  }
</style>