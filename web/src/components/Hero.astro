---
import Terminal from "./Terminal.astro";

const RELEASES_URL = "https://github.com/jhonatanmizu/vinci-convert/releases";

const heroLines = [
  { prompt: "❯ ", text: "vinci-convert convert ./clips/", label: "" },
  { text: "ffprobe: scene_01.mp4 · yuv420p · 29.97 fps", kind: "dim" },
  { bar: true, pct: 72, prompt: "❯ ", text: "scene_01.mp4 → ProRes HQ (422)" },
  { text: "scene_01.mp4 → converted/scene_01.mov", kind: "success" },
  { text: "Done! 4/4 files converted.", kind: "success" },
  { text: "♥ Apoie o projeto · Support the project", kind: "accent" },
];
---

<section class="hero container" id="top">
  <div class="hero-grid">
    <div class="hero-copy">
      <div class="badge">v0.1.0 · open source · free forever</div>
      <h1>
        Convert to <span class="grad">ProRes</span>.<br />
        Cut in DaVinci Resolve.
      </h1>
      <p class="hero-sub">
        vinci-convert probes your footage, picks the right ProRes profile
        (HQ, 4444 or stream copy), and batch-converts with a Catppuccin
        terminal UI — then exports back to H264 when it&apos;s time to
        deliver.
      </p>
      <div class="hero-cta">
        <a class="btn btn-primary" href="#pricing">See Pricing</a>
        <a class="btn btn-outline" href="#docs">View CLI Docs</a>
      </div>
      <p class="hero-note">
        GPL-3.0 open source · ProRes HQ / 4444 · stream-copy safe ·
        H264 export
      </p>
    </div>

    <div class="hero-terminal">
      <Terminal title="vinci-convert — DaVinci Resolve Converter" lines={heroLines} />
    </div>
  </div>
</section>

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    font-weight: 600;
    color: var(--mauve);
    border: 1px solid var(--surface1);
    border-radius: 900px;
    padding: 6px 14px;
    margin-bottom: 22px;
  }

  .badge::before {
    content: "";
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--green);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 56px;
    align-items: center;
    padding: 72px 0 40px;
  }

  h1 {
    font-size: 44px;
  }

  .grad {
    background: linear-gradient(90deg, var(--mauve), var(--lavender));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .hero-sub {
    margin-top: 20px;
    max-width: 520px;
    color: var(--subtext0);
    font-size: 16px;
  }

  .hero-cta {
    display: flex;
    gap: 16px;
    margin-top: 30px;
    flex-wrap: wrap;
  }

  .hero-note {
    margin-top: 24px;
    font-size: 12.5px;
    color: var(--overlay0);
  }

  .hero-terminal {
    min-width: 0;
  }

  @media (max-width: 1000px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    h1 {
      font-size: 36px;
    }
  }

  @media (max-width: 560px) {
    .hero-grid {
      padding: 48px 0 28px;
      gap: 28px;
    }
    h1 {
      font-size: 30px;
    }
    .badge {
      margin-bottom: 18px;
    }
    .hero-sub {
      font-size: 15px;
    }
    .hero-cta {
      flex-direction: column;
      gap: 12px;
      margin-top: 24px;
    }
    .hero-cta .btn {
      width: 100%;
    }
    .hero-note {
      font-size: 11.5px;
      line-height: 1.5;
      margin-top: 18px;
    }
  }
</style>